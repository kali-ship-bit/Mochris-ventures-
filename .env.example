# Example only. Copy this file to .env and fill in real values.
# Never commit .env. Rename these to match the backend you choose.

# Public values (safe to appear in the browser) start with VITE_.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Secret values are for the server only: never start them with VITE_
# and never paste them into code. Set them in your host's environment settings.
# SUPABASE_SERVICE_ROLE_KEY=
